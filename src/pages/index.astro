---
// src/pages/index.astro

// ==========================================
// 1. 必要なコンポーネントのインポート
// ==========================================
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

// ==========================================
// 2. ページ固有のデータを定義
// ==========================================
// SEO用データ（トップページは title を省略してサイト名のみ表示）
const pageDescription =
  "株式会社サンプルは、Webサイト制作・システム開発・マーケティング支援でお客様のビジネスを支えるWeb制作会社です。";

// サービス概要（テンプレート用のダミーデータ）
const services = [
  {
    title: "Webサイト制作",
    description: "企画・デザインから制作まで。スマートフォン対応やSEO対策も標準で行います。",
  },
  {
    title: "Webシステム開発",
    description: "予約システムや会員サイトなど、業務に合わせたシステムを開発します。",
  },
  {
    title: "Webマーケティング支援",
    description: "アクセス解析をもとに、集客と成果につながる施策をご提案します。",
  },
];

// 選ばれる理由（テンプレート用のダミーデータ）
const strengths = [
  {
    number: "01",
    title: "ワンストップ対応",
    description: "企画から制作、公開後の運用まで、窓口ひとつでまとめてお任せいただけます。",
  },
  {
    number: "02",
    title: "成果にこだわる提案",
    description: "見た目だけでなく、問い合わせや売上につながる設計を大切にしています。",
  },
  {
    number: "03",
    title: "公開後も安心のサポート",
    description: "更新作業やトラブル対応など、公開後も継続してサポートします。",
  },
];

// お知らせ（テンプレート用のダミーデータ）
const news = [
  { date: "2025-10-01", title: "年末年始の営業日についてのお知らせ" },
  { date: "2025-09-15", title: "Webマーケティング支援サービスの提供を開始しました" },
  { date: "2025-08-01", title: "コーポレートサイトをリニューアルしました" },
];
---

{/* 3. レイアウトで全体を囲み、SEOデータを渡す */}
<Layout description={pageDescription}>
  <main>
    {/* メインビジュアル */}
    <section class="hero">
      <div class="container">
        <p class="hero-sub">Web制作・システム開発</p>
        <h1 class="hero-title">Webの力で、<br />ビジネスをもっと前へ。</h1>
        <p class="hero-text">
          企画から制作、公開後の運用まで。<br />
          お客様の課題に寄り添い、成果につながるWebサイトをご提供します。
        </p>
        <div class="hero-actions">
          <Button href="/services/">サービスを見る</Button>
          <Button href="/contact/" variant="outline-white">お問い合わせ</Button>
        </div>
      </div>
    </section>

    {/* サービス */}
    <section class="section">
      <div class="container">
        <h2 class="section-title">サービス</h2>
        <ul class="card-list">
          {
            services.map((service) => (
              <li class="card">
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </li>
            ))
          }
        </ul>
        <div class="section-more">
          <a href="/services/" class="link-more">サービス一覧へ</a>
        </div>
      </div>
    </section>

    {/* 選ばれる理由 */}
    <section class="section section-gray">
      <div class="container">
        <h2 class="section-title">選ばれる理由</h2>
        <ul class="strength-list">
          {
            strengths.map((item) => (
              <li class="strength">
                <span class="strength-number">{item.number}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* お知らせ */}
    <section class="section">
      <div class="container container-narrow">
        <h2 class="section-title">お知らせ</h2>
        <ul class="news-list">
          {
            news.map((item) => (
              <li class="news-item">
                <time datetime={item.date}>{item.date.replaceAll("-", ".")}</time>
                <span>{item.title}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* お問い合わせ誘導 */}
    <section class="cta">
      <div class="container">
        <h2 class="cta-title">まずはお気軽にご相談ください</h2>
        <p class="cta-text">お見積りは無料です。ご相談内容が固まっていなくても大丈夫です。</p>
        <Button href="/contact/" variant="white">お問い合わせはこちら</Button>
      </div>
    </section>
  </main>
</Layout>

{/* 4. ページ固有のスタイル（スコープ付き） */}
<style lang="scss">
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .container-narrow {
    max-width: 800px;
  }

  /* メインビジュアル */
  .hero {
    background: linear-gradient(135deg, var.$color-gray-900 0%, var.$color-primary-deep 100%);
    color: #ffffff;
    padding: 4rem 0;

    @include var.media_query_tablet_up {
      padding: 6rem 0;
    }
  }

  .hero-sub {
    color: var.$color-primary-light;
    font-weight: bold;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: 2rem;
    line-height: 1.4;
    margin-bottom: 1.5rem;

    @include var.media_query_tablet_up {
      font-size: 3rem;
    }
  }

  .hero-text {
    color: var.$color-gray-300;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* セクション共通 */
  .section {
    padding: 4rem 0;
  }

  .section-gray {
    background-color: var.$color-gray-50;
  }

  .section-title {
    font-size: 1.75rem;
    color: var.$color-gray-900;
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-more {
    margin-top: 2rem;
    text-align: center;
  }

  .link-more {
    color: var.$color-primary;
    font-weight: 600;
    &::after {
      content: " →";
    }
  }

  /* サービス */
  .card-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;

    @include var.media_query_tablet_up {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    border: 1px solid var.$color-gray-200;
    border-radius: 8px;
    padding: 1.5rem;
    color: var.$color-gray-600;
    line-height: 1.6;

    h3 {
      color: var.$color-gray-900;
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }
  }

  /* 選ばれる理由 */
  .strength-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2rem;

    @include var.media_query_tablet_up {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .strength {
    text-align: center;
    color: var.$color-gray-600;
    line-height: 1.6;

    h3 {
      color: var.$color-gray-900;
      font-size: 1.125rem;
      margin-bottom: 0.75rem;
    }
  }

  .strength-number {
    display: block;
    font-size: 2.5rem;
    font-weight: bold;
    color: var.$color-primary;
    line-height: 1;
    margin-bottom: 1rem;
  }

  /* お知らせ */
  .news-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var.$color-gray-200;
  }

  .news-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid var.$color-gray-200;
    color: var.$color-gray-800;

    @include var.media_query_tablet_up {
      flex-direction: row;
      gap: 2rem;
    }

    time {
      color: var.$color-gray-500;
      flex-shrink: 0;
    }
  }

  /* お問い合わせ誘導 */
  .cta {
    background-color: var.$color-primary-deep;
    color: #ffffff;
    text-align: center;
    padding: 4rem 0;
  }

  .cta-title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .cta-text {
    color: var.$color-gray-300;
    margin-bottom: 2rem;
  }
</style>
