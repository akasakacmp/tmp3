---
// src/pages/index.astro

// ==========================================
// 1. 必要なコンポーネントのインポート
// ==========================================
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

// ==========================================
// 2. ページ固有のデータ（Props）を定義
// ==========================================
// SEO用データ
const pageTitle = "サービス案内";
const pageDescription = "当社の提供するサービス一覧についてご紹介します。";
const isNoindex = false; // インデックスさせたくない場合は true にする

// パンくずリスト用データ
// ホームから現在地（サービス案内）までの階層を配列で定義
const breadcrumbItems = [
  { name: "Home", href: "/" },
  { name: "サービス案内" }, // 現在地は href を省略
];
---

{/* 3. レイアウトで全体を囲み、SEOデータを渡す */}
<Layout title={pageTitle} description={pageDescription} noindex={isNoindex}>
  {/* メインコンテンツ領域 */}
  <main class="main-content">
    {/* パンくずリストコンポーネントの配置 (Propsとして階層データを渡す) */}
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    {/* ページ独自の内容 */}
    <div class="container">
      <h1 class="page-title">{pageTitle}</h1>

      <section class="content-section">
        <p>
          ここは <code>index.astro</code> ページのメインコンテンツ領域です。<br
          />
          Header と Footer に挟まれた部分が、このページ独自のコンテンツとして表示されます。
        </p>

        <div class="dummy-box">
          <h2>サービスA</h2>
          <p>
            サービスAの詳細な説明が入ります。Astroのコンポーネントは非常に直感的に組み合わせていくことができます。
          </p>
        </div>

        <div class="dummy-box">
          <h2>サービスB</h2>
          <p>
            サービスBの説明です。画面を下までスクロールすると Footer
            が表示されます。
          </p>
        </div>
      </section>
    </div>
  </main>
</Layout>

{/* 4. ページ固有のスタイル（スコープ付き） */}
<style lang="scss">
  /* このページ内でのみ適用されるスタイル */
  .main-content {
    padding: 2rem 0 4rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .page-title {
    font-size: 2rem;
    color: #1e293b;
    margin-bottom: 2rem;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 0.5rem;
  }

  .content-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    line-height: 1.6;
    color: #475569;
  }

  .dummy-box {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
    h2 {
      color: #0f172a;
      margin-top: 0;
      font-size: 1.25rem;
    }
  }
</style>
