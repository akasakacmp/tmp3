---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout title="404 - ページが見つかりません" noindex={true}>
  <main class="error-page">
    <div class="container">
      <h1>404</h1>
      <h2>お探しのページは見つかりませんでした</h2>
      <p>
        アクセスしようとしたページは削除されたか、URLが変更されたか、<br
          class="desktop-only"
        />
        あるいは最初から存在しない可能性があります。
      </p>
      <div class="actions">
        <Button href="/">トップページへ戻る</Button>
      </div>
    </div>
  </main>
</Layout>

<style lang="scss">
  .error-page {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
    text-align: center;
    padding: 4rem 2rem;
  }

  .container {
    max-width: 600px;
  }

  h1 {
    font-size: 6rem;
    font-weight: bold;
    margin: 0;
    color: var.$color-gray-300; /* 威圧感を与えない薄いグレーなど */
    line-height: 1;
  }

  h2 {
    font-size: 1.5rem;
    margin: 1.5rem 0;
    color: var.$color-gray-700;
  }

  p {
    color: var.$color-gray-500;
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }

  .desktop-only {
    display: none;
  }

  @include var.media_query_tablet_up {
    .desktop-only {
      display: inline;
    }
  }

  .actions {
    margin-top: 2rem;
  }
</style>
