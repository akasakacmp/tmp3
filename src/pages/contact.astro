---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Button from "../components/Button.astro";

const pageTitle = "お問い合わせ";
const pageDescription = "サービスに関するご相談・お見積りのご依頼は、こちらのフォームからお気軽にお問い合わせください。";

const breadcrumbItems = [
  { name: "Home", href: "/" },
  { name: pageTitle },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="main-content">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
      <h1 class="page-title">{pageTitle}</h1>

      <p class="intro">
        サービスに関するご相談・お見積りのご依頼は、下記フォームよりお問い合わせください。<br />
        通常2営業日以内に担当者よりご連絡いたします。
      </p>

      {/* 見た目だけのフォーム。送信処理は未実装（フォームサービスやAPIに合わせて action を設定してください） */}
      <form class="contact-form">
        <div class="form-item">
          <label class="form-label" for="name">お名前 <span class="form-required">必須</span></label>
          <input class="form-input" type="text" id="name" name="name" autocomplete="name" required />
        </div>

        <div class="form-item">
          <label class="form-label" for="company">会社名</label>
          <input class="form-input" type="text" id="company" name="company" autocomplete="organization" />
        </div>

        <div class="form-item">
          <label class="form-label" for="email">メールアドレス <span class="form-required">必須</span></label>
          <input class="form-input" type="email" id="email" name="email" autocomplete="email" required />
        </div>

        <div class="form-item">
          <label class="form-label" for="category">お問い合わせ種別</label>
          <select class="form-select" id="category" name="category">
            <option value="service">サービスについて</option>
            <option value="estimate">お見積りのご依頼</option>
            <option value="other">その他</option>
          </select>
        </div>

        <div class="form-item">
          <label class="form-label" for="message">お問い合わせ内容 <span class="form-required">必須</span></label>
          <textarea class="form-textarea" id="message" name="message" rows="6" required></textarea>
        </div>

        <p class="privacy-note">
          <a href="/privacy/">プライバシーポリシー</a>に同意のうえ、送信してください。
        </p>

        <div class="form-actions">
          <Button>送信する</Button>
        </div>
      </form>
    </div>
  </main>
</Layout>

<style lang="scss">
  .main-content {
    padding: 2rem 0 4rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .page-title {
    font-size: 2rem;
    color: var.$color-gray-800;
    margin-bottom: 2rem;
    border-bottom: 2px solid var.$color-gray-200;
    padding-bottom: 0.5rem;
  }

  .intro {
    color: var.$color-gray-600;
    line-height: 1.8;
    max-width: 800px;
    margin: 0 auto 2rem;
  }

  .contact-form {
    max-width: 800px;
    margin: 0 auto;
  }

  .privacy-note {
    color: var.$color-gray-600;
    font-size: 0.875rem;
    margin: 2rem 0 1.5rem;

    a {
      color: var.$color-primary;
    }
  }
</style>
