---
// src/components/SEO.astro
import { SITE_NAME } from "../consts";

const {
  title,
  description,
  noindex = false,
  ogImage = "/default-ogp.png", // public直下に仮のデフォルト画像を置いておく
  ogType = "website", // 記事ページでは "article" を渡す
} = Astro.props;

const finalTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const finalDesc = description || "デフォルトのサイト説明文...";

// canonical URLを絶対パスで生成する
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<title>{finalTitle}</title>
<meta name="description" content={finalDesc} />

{/* noindexの制御 */}
{noindex && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonicalURL} />

{/* OGP / Twitter Card の最適化 */}
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={finalDesc} />
<meta property="og:image" content={new URL(ogImage, Astro.site)} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={finalDesc} />
<meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
